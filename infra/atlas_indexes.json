{
  "_comment": "Atlas Vector Search index definitions. numDimensions is overridden at apply time by EMBED_DIM in .env (see infra/create_atlas_index.py). knowledge_v2 is the blue/green target for BackfillWorkflow and typically uses the upgraded model's dimensions.",
  "collections": {
    "knowledge": {
      "name": "vector_index",
      "type": "vectorSearch",
      "definition": {
        "fields": [
          {
            "type": "vector",
            "path": "embedding",
            "numDimensions": 1024,
            "similarity": "cosine"
          },
          { "type": "filter", "path": "doc_id" },
          { "type": "filter", "path": "source_uri" }
        ]
      }
    },
    "knowledge_v2": {
      "name": "vector_index",
      "type": "vectorSearch",
      "definition": {
        "fields": [
          {
            "type": "vector",
            "path": "embedding",
            "numDimensions": 1024,
            "similarity": "cosine"
          },
          { "type": "filter", "path": "doc_id" },
          { "type": "filter", "path": "source_uri" }
        ]
      }
    }
  }
}
