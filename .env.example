# ---- Temporal (local dev server: `temporal server start-dev`) ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pra-pipeline

# ---- Kafka (Redpanda via infra/docker-compose.yml) ----
KAFKA_BOOTSTRAP=localhost:19092
RAW_TOPIC=raw
CHUNKS_TOPIC=chunks

# ---- MongoDB Atlas (REQUIRED) ----
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pra
KNOWLEDGE_COLLECTION=knowledge
KNOWLEDGE_V2_COLLECTION=knowledge_v2

# ---- Voyage AI (REQUIRED) ----
VOYAGE_API_KEY=<your-voyage-api-key>
VOYAGE_MODEL=voyage-3
EMBED_DIM=1024

# ---- S3 source ----
# Source selection: "auto" picks minio (if S3_ENDPOINT_URL set) -> sqs (if SQS_QUEUE_URL set) -> poll.
S3_SOURCE=auto
AWS_REGION=us-east-1

# --- Option A: MinIO (self-contained demo, from infra/docker-compose.yml) ---
# MinIO publishes S3 events natively to Kafka — no SQS needed.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=pra-bucket
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Option B: real AWS S3 ---
# Comment out S3_ENDPOINT_URL above and set a real bucket + credentials.
# For the event-driven path, set the SQS queue that receives s3:ObjectCreated:* events;
# leave blank to fall back to bucket polling. See docs/RUNBOOK.md for the SQS wiring.
# S3_ENDPOINT_URL=
# S3_BUCKET=<your-bucket>
SQS_QUEUE_URL=

# ---- Chunking ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# ---- S3 poll fallback (used only when SQS_QUEUE_URL is empty) ----
S3_POLL_PREFIX=
S3_POLL_INTERVAL_SECONDS=15
