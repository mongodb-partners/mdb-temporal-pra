# ---- Temporal (local dev server: `temporal server start-dev`) ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=temporal-pipeline

# ---- MongoDB Atlas (REQUIRED) ----
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=temporal
CHUNKS_COLLECTION=chunks_staging
# Zero-copy searchable collection: pointers and vectors, never text.
KNOWLEDGE_COLLECTION=knowledge_zc
KNOWLEDGE_V2_COLLECTION=knowledge_v2
CONFIG_COLLECTION=temporal_config
MEMORY_COLLECTION=agent_memory

# ---- Voyage AI (REQUIRED) ----
VOYAGE_API_KEY=<your-voyage-api-key>
VOYAGE_MODEL=voyage-3.5
VOYAGE_RERANK_MODEL=rerank-2.5
# A key starting "al-" is issued for MongoDB's hosted endpoint; a key from
# voyageai.com needs VOYAGE_BASE_URL=https://api.voyageai.com/v1 instead.
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
EMBED_DIM=1024

# ---- OpenAI (REQUIRED for the durable research agent) ----
OPENAI_API_KEY=<your-openai-api-key>
AGENT_MODEL=gpt-4.1
# Optional: any OpenAI-compatible gateway. Leave blank for api.openai.com.
OPENAI_BASE_URL=
# Also send OPENAI_API_KEY in this header (e.g. api-key for Azure style gateways).
OPENAI_API_KEY_HEADER=
# false = Chat Completions (needed by most gateways; disables the hosted web search tool).
OPENAI_USE_RESPONSES=true

# ---- S3 source (REQUIRED) ----
# The worker indexes this bucket and read_span_tool reads it back, so both see
# the same bucket. The IAM principal needs s3:PutObject and s3:GetObject on it.
AWS_REGION=us-east-1
S3_BUCKET=<your-bucket>
# Leave both blank to use boto3's standard credential chain (profile / role).
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
# Optional: an S3-compatible endpoint. For local MinIO copy this file to .env.minio with
#   S3_ENDPOINT_URL=http://localhost:9000  AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin       S3_BUCKET=temporal-datasources
# and run: make start ENV_FILE=.env.minio  (starts MinIO and wires its webhook).
S3_ENDPOINT_URL=

# ---- Chunking ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# ---- Service ports ----
TRIGGER_API_PORT=8088
AGENT_API_PORT=8090
