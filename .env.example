# ---- Temporal (local dev server: `temporal server start-dev`) ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=temporal-pipeline

# ---- Kafka (Confluent cp-kafka) + Kafka Connect (infra/docker-compose.yml) ----
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_CONNECT_URL=http://localhost:8083

# ---- MongoDB Atlas (REQUIRED) ----
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=temporal
SRC_COLLECTION=sources
CHUNKS_COLLECTION=chunks_staging
KNOWLEDGE_AUTO_EMBEDDING_COLLECTION=knowledge_auto_embedding
CONFIG_COLLECTION=temporal_config
MEMORY_COLLECTION=agent_memory

# ---- OpenAI (REQUIRED for RAG answers) ----
OPENAI_API_KEY=<your-openai-api-key>
ANSWER_MODEL=gpt-4o

# ---- S3 source (MinIO self-contained demo) ----
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=temporal-datasources
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# For real AWS S3: comment out S3_ENDPOINT_URL and set a real bucket + credentials.

# ---- Chunking ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# ---- Service ports ----
TRIGGER_API_PORT=8088
AGENT_API_PORT=8090
